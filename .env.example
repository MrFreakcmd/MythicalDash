# MythicalDash v3 Environment Configuration
# Copy this file to .env and update with your values
# DO NOT commit .env to version control

# ============================================
# DATABASE CONFIGURATION
# ============================================

# MariaDB Root Password (high security)
MARIADB_ROOT_PASSWORD=change_me_secure_root_password

# Database Name
MARIADB_DATABASE=mythicaldash_v3

# Database User
MARIADB_USER=mythicaldash_v3

# Database User Password (high security)
MARIADB_PASSWORD=change_me_secure_db_password

# Auto-upgrade MariaDB on container start
MARIADB_AUTO_UPGRADE=1

# ============================================
# REDIS CONFIGURATION
# ============================================

# Redis Authentication Password (high security)
REDIS_PASSWORD=change_me_secure_redis_password

# ============================================
# BACKEND CONFIGURATION
# ============================================

# Database Encryption Method
# Options: xchacha20, aes-256-gcm, none
DATABASE_ENCRYPTION=xchacha20

# Database Encryption Key (32 character base64 encoded)
# Generate with: openssl rand -base64 32
DATABASE_ENCRYPTION_KEY=zKZ7//AocUD2wCuzjW5rdTbb8FvGBgKTZ8iCATslZ/8=

# ============================================
# APPLICATION SETTINGS
# ============================================

# Application Environment
# Options: development, production, testing
APP_ENV=production

# Application Debug Mode (ALWAYS false in production)
APP_DEBUG=false

# Application Name
APP_NAME=MythicalDash

# Application URL
APP_URL=http://localhost:4832

# Application Key (optional - for Laravel/Lumen)
APP_KEY=

# ============================================
# MAIL CONFIGURATION (Optional)
# ============================================

# Mail Driver: mail, mailgun, mailtrap, ses, sendgrid
MAIL_DRIVER=mailtrap

# Mail Host
MAIL_HOST=smtp.mailtrap.io

# Mail Port
MAIL_PORT=465

# Mail Username
MAIL_USERNAME=

# Mail Password
MAIL_PASSWORD=

# Mail From Address
MAIL_FROM_ADDRESS=noreply@mythicaldash.local

# Mail From Name
MAIL_FROM_NAME=MythicalDash

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Log Channel: stack, single, syslog, errorlog, daily
LOG_CHANNEL=daily

# Log Level: debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=error

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================

# Maximum file upload size (in bytes)
UPLOAD_MAX_FILESIZE=104857600  # 100MB

# Maximum POST size (in bytes)
POST_MAX_SIZE=104857600  # 100MB

# ============================================
# CACHE CONFIGURATION
# ============================================

# Cache Driver: file, redis, memcached, database
CACHE_DRIVER=redis

# ============================================
# SESSION CONFIGURATION
# ============================================

# Session Driver: file, cookie, database, redis
SESSION_DRIVER=redis

# Session Lifetime (in minutes)
SESSION_LIFETIME=525600

# ============================================
# QUEUE CONFIGURATION
# ============================================

# Queue Driver: sync, database, redis, sqs
QUEUE_DRIVER=redis

# ============================================
# FEATURES & FUNCTIONALITY
# ============================================

# Enable Debug Bar (development only)
DEBUG_BAR=false

# Enable API Documentation
API_DOCS=true

# ============================================
# EXTERNAL SERVICES (Optional)
# ============================================

# Stripe Configuration (if using Stripe)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal Configuration (if using PayPal)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Discord Integration (if enabled)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_WEBHOOK_URL=

# ============================================
# DOCKER COMPOSE ENVIRONMENT
# ============================================

# These are used by Docker Compose for service networking
# Generally, do not modify these
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USER=mythicaldash_v3
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# SECURITY SETTINGS
# ============================================

# CSRF Token
CSRF_TOKEN=

# Trusted Proxies (for reverse proxy setups)
TRUSTED_PROXIES=*

# ============================================
# TIMEZONE
# ============================================

# Application Timezone
APP_TIMEZONE=UTC
